---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="联系名片" description="个人介绍与联系入口。" active="card">
  <section class="card-page wrap"><div class="intro"><span class="eyebrow">CONTACT / 电子名片</span><h1>从这里，<br /><em>开始交流。</em></h1><p>这里整理了我的技术方向与工作经历。公开联系方式将在确认后添加。</p><div class="small-line"><span>01</span><span>认识彼此</span><span>→</span><span>02</span><span>交换想法</span></div></div><div class="card"><div class="card-top"><span>PERSONAL CARD</span><span>↗</span></div><div class="avatar">{profile.initials}</div><h2>{profile.name}</h2><p class="role">{profile.role}</p><p class="summary">{profile.summary}</p><div class="tag-list">{profile.focus.map((item) => <span>{item}</span>)}</div><div class="details"><div><span>所在地</span><strong>{profile.location}</strong></div>{profile.email && <div><span>邮箱</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div>}{profile.github && <div><span>GitHub</span><a href={profile.github} target="_blank" rel="noopener noreferrer">查看主页 ↗</a></div>}{profile.linkedin && <div><span>LinkedIn</span><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">查看主页 ↗</a></div>}</div>{!profile.email && !profile.github && !profile.linkedin && <p class="pending">公开联系方式待确认</p>}</div></section>
</BaseLayout>
<style>
  .card-page{display:grid;grid-template-columns:1fr 480px;gap:80px;align-items:center;padding-top:95px;padding-bottom:120px;min-height:680px}.intro h1{font-size:clamp(50px,6vw,78px);line-height:1.15;letter-spacing:-.075em;color:#173d36;margin:25px 0}.intro h1 em{color:#86ad60;font-style:normal}.intro p{max-width:440px;color:#718176;line-height:1.85}.small-line{display:flex;align-items:center;gap:13px;margin-top:75px;color:#74947b;font-size:11px;font-weight:750;letter-spacing:.1em}.small-line span:nth-child(3){margin-inline:12px;color:#2b6b4b}.card{background:#fdfef9;border:1px solid #d6e2d4;border-radius:19px;padding:35px 38px 37px;box-shadow:0 26px 70px #254b3614;position:relative;overflow:hidden}.card:after{content:"";position:absolute;width:280px;height:280px;right:-100px;top:-115px;border-radius:50%;background:#e1f0d9;z-index:0}.card>*{position:relative;z-index:1}.card-top{display:flex;justify-content:space-between;color:#6b9074;font-size:10px;font-weight:800;letter-spacing:.14em}.card-top span:last-child{font-size:22px;line-height:0}.avatar{height:73px;width:73px;display:grid;place-items:center;border-radius:20px;background:#1b483a;color:#d0ed9d;font-weight:800;font-size:23px;letter-spacing:-.05em;margin-top:50px}.card h2{font-size:34px;letter-spacing:-.06em;color:#163e36;margin:20px 0 5px}.role{font-size:13px;color:#4b7959;font-weight:750;margin:0}.summary{color:#748378;line-height:1.8;font-size:13px;margin:27px 0}.tag-list{display:flex;gap:7px;flex-wrap:wrap}.tag-list span{border:1px solid #c5dac2;color:#4e7558;border-radius:30px;padding:7px 10px;font-size:11px}.details{border-top:1px solid #e1e8dc;margin-top:29px;padding-top:20px;display:grid;gap:14px}.details div{display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:12px}.details div span{color:#879689}.details div strong,.details div a{color:#214c3c;font-weight:750}.pending{background:#eaf1e8;border-radius:7px;padding:12px;color:#658371;font-size:11px;text-align:center;margin:24px 0 0}@media(max-width:900px){.card-page{grid-template-columns:1fr;gap:50px;padding-top:65px;padding-bottom:80px}.small-line{margin-top:40px}.card{max-width:500px}}@media(max-width:500px){.card{padding:28px}.card h2{font-size:30px}}
</style>
