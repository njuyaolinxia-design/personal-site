---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true })) as Array<{ frontmatter: { title: string; description: string; pubDate: string | Date; category: string }; url: string }>;
const recentPosts = posts.sort((a, b) => +new Date(b.frontmatter.pubDate) - +new Date(a.frontmatter.pubDate)).slice(0, 2);
---
<BaseLayout title="首页" description="个人简历、项目经历与知识博客。" active="home">
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="eyebrow">PERSONAL PORTFOLIO / 个人主页</span>
      <p class="hero-kicker">你好，我是 {profile.name}。</p>
      <h1>把复杂的问题<br /><em>拆解、实践、沉淀。</em></h1>
      <p class="hero-desc">{profile.summary}</p>
      <div class="hero-actions"><a class="btn btn-dark" href="/work/">查看经历与项目 <span aria-hidden="true">↗</span></a><a class="btn btn-outline" href="/blog/">阅读知识博客</a></div>
      <div class="hero-meta"><span>当前方向 <strong>{profile.role}</strong></span><span>所在地 <strong>{profile.location}</strong></span></div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-top"><span>ABOUT / WORK / NOTES</span><span>001 — ∞</span></div>
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="art-center"><span>THINK</span><strong>→</strong><span>BUILD</span><strong>→</strong><span>SHARE</span></div>
      <div class="art-bottom"><span>持续构建中的个人知识档案</span><span class="art-star">✳</span></div>
    </div>
  </section>

  <section class="intro-band"><div class="wrap intro-inner"><span class="band-label">FOCUS / 关注领域</span><div>{profile.focus.map((item) => <span>{item}</span>)}</div><p>从项目实践到知识整理，留下可复用的方法与思考。</p></div></section>

  <section class="section wrap work-section">
    <div class="section-top"><div><span class="eyebrow">01 / EXPERIENCE & WORK</span><h2 class="section-heading">经历与项目</h2><p class="muted">用具体问题、行动和结果讲清楚做过的事。</p></div><a class="text-link" href="/work/">查看全部经历 <span aria-hidden="true">↗</span></a></div>
    {profile.projects.length ? <div class="project-grid">{profile.projects.slice(0, 2).map((project, index) => <a class="project-card" href="/work/"><div class="card-index">0{index + 1} / {project.category}</div><h3>{project.name}</h3><p>{project.description}</p><span>查看项目经历 ↗</span></a>)}</div> : <div class="empty-feature"><div class="empty-icon">↗</div><div><h3>项目案例即将补充</h3><p>正式简历确认后，这里会展示代表项目、负责内容与可公开成果。</p></div><a href="/work/">查看页面 →</a></div>}
  </section>

  <section class="notes-section"><div class="wrap"><div class="section-top"><div><span class="eyebrow">02 / WRITING</span><h2 class="section-heading">知识博客</h2><p class="muted">把工作中的方法、复盘和学习记录写成可以持续更新的文章。</p></div><a class="text-link" href="/blog/">浏览所有文章 <span aria-hidden="true">↗</span></a></div><div class="notes-grid">{recentPosts.map((post) => <a class="note-card" href={post.url}><div class="note-top"><span>{post.frontmatter.category}</span><span>{new Date(post.frontmatter.pubDate).toISOString().slice(0, 10)}</span></div><h3>{post.frontmatter.title}</h3><p>{post.frontmatter.description}</p><span class="read-more">阅读全文 ↗</span></a>)}</div></div></section>

  <section class="contact-section wrap"><div><span class="eyebrow">03 / CONNECT</span><h2>保持交流，<br />也保持记录。</h2><p>关于工作经历、技术交流或内容反馈，可以从名片页找到联系入口。</p></div><a class="btn btn-dark" href="/card/">打开联系名片 ↗</a></section>
</BaseLayout>

<style>
  .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:58px;align-items:center;padding-top:75px;padding-bottom:93px}.hero-kicker{font-size:17px;font-weight:650;color:#456a5e;margin:44px 0 17px}.hero h1{font-size:clamp(48px,5.8vw,82px);line-height:1.13;letter-spacing:-.075em;color:#153a36;margin:0;white-space:nowrap}.hero h1 em{font-style:normal;color:#83a75b}.hero-desc{color:#63756d;line-height:1.95;max-width:550px;font-size:15px;margin:29px 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero-meta{display:flex;gap:33px;border-top:1px solid #dce5db;margin-top:65px;padding-top:22px;font-size:11px;color:#799087}.hero-meta span{display:flex;flex-direction:column;gap:7px}.hero-meta strong{font-size:13px;color:#22473e}.hero-art{height:540px;background:#d9e5d9;position:relative;border-radius:14px;overflow:hidden;color:#234b40;box-shadow:0 24px 70px #23443d19}.hero-art:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 54% 48%,#f2f6e1 0,#d8e7d6 39%,#b6d3c3 100%)}.hero-art:after{content:"";position:absolute;inset:0;background-image:linear-gradient(#2d6b5112 1px,transparent 1px),linear-gradient(90deg,#2d6b5112 1px,transparent 1px);background-size:34px 34px}.art-top,.art-bottom{position:absolute;left:32px;right:32px;z-index:2;display:flex;justify-content:space-between;font-size:10px;font-weight:750;letter-spacing:.13em}.art-top{top:30px}.art-bottom{bottom:27px;align-items:end}.art-star{font-size:38px;line-height:1}.orbit{position:absolute;border:1px solid #2e77564b;border-radius:50%;z-index:1;left:50%;top:50%;transform:translate(-50%,-50%)}.orbit-one{width:290px;height:290px}.orbit-two{width:440px;height:440px}.orbit-three{width:610px;height:610px}.art-center{position:absolute;z-index:3;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;gap:13px;background:#153e36;color:#e6f5d2;padding:23px 26px;border-radius:100px;font-size:14px;font-weight:800;letter-spacing:.06em;box-shadow:0 16px 40px #1745374d}.art-center strong{color:#a2d05b;font-size:18px}.intro-band{background:#eaf0e8;border-top:1px solid #dce7d8;border-bottom:1px solid #dce7d8}.intro-inner{display:flex;align-items:center;gap:30px;min-height:100px}.band-label{font-size:10px;font-weight:800;color:#758f7b;letter-spacing:.13em}.intro-inner div{display:flex;gap:10px;flex-wrap:wrap}.intro-inner div span{border:1px solid #bfd4bd;border-radius:50px;padding:8px 13px;font-size:12px;font-weight:650;color:#315b47}.intro-inner p{margin-left:auto;color:#6c7e72;font-size:12px}.section{padding-top:114px;padding-bottom:115px}.section-top{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:35px}.section-top .muted{margin:0}.text-link{font-size:13px;color:#245641;font-weight:750;border-bottom:1px solid #93ad99;padding-bottom:7px;white-space:nowrap}.project-grid,.notes-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.project-card{background:#fff;border:1px solid #dce6dc;border-radius:12px;padding:32px;min-height:260px;display:flex;flex-direction:column}.card-index,.note-top{color:#749181;font-size:11px;font-weight:700;letter-spacing:.06em}.project-card h3,.note-card h3{font-size:24px;letter-spacing:-.04em;color:#183d35;margin:34px 0 9px}.project-card p,.note-card p{color:#6c7e71;line-height:1.8;font-size:13px}.project-card span:last-child{margin-top:auto;color:#2f6a4c;font-size:12px;font-weight:750}.empty-feature{border:1px solid #d5e3d5;background:#fdfefb;border-radius:12px;padding:35px;display:flex;align-items:center;gap:27px}.empty-icon{width:64px;height:64px;display:grid;place-items:center;border-radius:50%;background:#e4efdd;color:#3b7953;font-size:28px}.empty-feature h3{margin:0 0 9px;color:#1d493b}.empty-feature p{margin:0;color:#718175;font-size:13px}.empty-feature a{margin-left:auto;color:#2f6a4c;font-weight:750;font-size:12px;white-space:nowrap}.notes-section{background:#eaf0e8;padding:108px 0 115px}.note-card{display:block;background:#f9fbf6;border:1px solid #dce7d9;border-radius:12px;padding:30px;min-height:262px}.note-top{display:flex;justify-content:space-between}.note-card h3{margin:41px 0 10px}.read-more{display:inline-block;color:#2c6a4c;font-size:12px;font-weight:750;margin-top:20px}.contact-section{display:flex;align-items:end;justify-content:space-between;gap:30px;padding-top:100px;padding-bottom:105px}.contact-section h2{font-size:clamp(34px,5vw,58px);line-height:1.15;letter-spacing:-.06em;color:#173d36;margin:18px 0}.contact-section p{color:#708074;line-height:1.8;font-size:14px}
  @media(max-width:950px){.hero{gap:30px}.hero-art{height:460px}.intro-inner p{display:none}}@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:54px;padding-bottom:65px}.hero-kicker{margin-top:35px}.hero h1{white-space:normal;font-size:clamp(35px,8.5vw,55px)}.hero-meta{margin-top:40px}.hero-art{height:340px}.art-center{font-size:11px;gap:8px;padding:17px}.intro-inner{padding-top:20px;padding-bottom:20px;align-items:flex-start;flex-direction:column;gap:12px}.section,.notes-section{padding-top:72px;padding-bottom:78px}.section-top{display:block}.section-top .text-link{display:inline-block;margin-top:22px}.project-grid,.notes-grid{grid-template-columns:1fr}.empty-feature{align-items:flex-start;flex-direction:column}.empty-feature a{margin-left:0}.contact-section{align-items:flex-start;flex-direction:column;padding-top:75px;padding-bottom:85px}}
</style>
