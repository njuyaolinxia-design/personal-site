---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="经历与项目" description="工作经历、代表项目和解决问题的方法。" active="work">
  <section class="page-head wrap"><span class="eyebrow">EXPERIENCE & PROJECTS</span><h1>经历与项目</h1><p>经历说明我做过什么；项目展示我如何分析问题、采取行动，并验证结果。</p></section>
  <section class="content wrap"><div class="section-label"><span>01 / 工作经历</span><h2>职业历程</h2></div><div class="list">{profile.experience.length ? profile.experience.map((item) => <article class="experience"><div class="period">{item.period}</div><div><h3>{item.role}</h3><span class="org">{item.company}</span><p>{item.description}</p><ul>{item.highlights.map((point) => <li>{point}</li>)}</ul></div></article>) : <div class="placeholder"><strong>正式工作经历待补充</strong><p>建议每段包含任职时间、公司/团队、岗位，以及 2～3 条经过脱敏的具体成果。</p></div>}</div></section>
  <section class="content wrap projects"><div class="section-label"><span>02 / 代表项目</span><h2>项目实践</h2></div><div class="list">{profile.projects.length ? profile.projects.map((item) => <article class="project"><div class="project-top"><span class="type">{item.category}</span><span class="period">{item.period}</span></div><h3>{item.name}</h3><p>{item.description}</p><div class="contribution"><strong>我的贡献</strong><p>{item.contribution}</p></div>{item.link && <a href={item.link} target="_blank" rel="noopener noreferrer">查看项目 ↗</a>}</article>) : <div class="placeholder"><strong>代表项目待补充</strong><p>推荐按“背景 → 个人职责 → 方法 → 可公开结果”整理，每个项目突出一项核心能力。</p></div>}</div></section>
  <section class="content wrap education"><div class="section-label"><span>03 / 教育背景</span><h2>学习经历</h2></div><div class="list">{profile.education.map((item) => <article class="education-item"><span class="period">{item.period}</span><div><h3>{item.school}</h3><p>{item.degree}</p></div></article>)}</div></section>
  <section class="end-cta wrap"><span class="eyebrow">NEXT / CONTINUE</span><h2>实践之外，继续写作。</h2><p>项目中的方法和思考，会逐步沉淀为博客文章。</p><a class="btn btn-dark" href="/blog/">浏览知识博客 ↗</a></section>
</BaseLayout>
<style>
  .page-head{padding-top:94px;padding-bottom:85px;border-bottom:1px solid #dce5db}.page-head h1{font-size:clamp(48px,6vw,78px);letter-spacing:-.07em;color:#163d36;margin:19px 0}.page-head p{color:#6d7f72;line-height:1.8;max-width:680px}.content{display:grid;grid-template-columns:250px 1fr;gap:80px;padding-top:95px;padding-bottom:95px;border-bottom:1px solid #dce5db}.section-label span{font-size:11px;color:#6c9277;font-weight:800;letter-spacing:.12em}.section-label h2{font-size:28px;color:#183e36;letter-spacing:-.04em}.list{display:grid;gap:16px}.experience,.project,.placeholder,.education-item{background:#fff;border:1px solid #dde7dc;border-radius:12px;padding:30px}.experience,.education-item{display:grid;grid-template-columns:150px 1fr;gap:20px}.period{font-size:12px;color:#527f62;font-weight:800}.experience h3,.project h3,.education-item h3{font-size:23px;color:#173e36;margin:0 0 9px;letter-spacing:-.035em}.org,.type{font-size:12px;color:#4c795f;font-weight:700}.experience p,.project p,.placeholder p,.education-item p{font-size:13px;line-height:1.85;color:#6d7d71}.experience ul{padding-left:20px;color:#526c5a;font-size:13px;line-height:1.9}.placeholder{background:#f8faf6;border-style:dashed;min-height:165px}.placeholder strong{color:#224a3c}.project-top{display:flex;justify-content:space-between;gap:16px;margin-bottom:16px}.project .contribution{border-top:1px solid #e3eae1;margin-top:24px;padding-top:16px}.project .contribution strong{font-size:12px;color:#244e3d}.project a{font-size:12px;color:#347052;font-weight:700}.education-item p{margin:0}.end-cta{padding-top:90px;padding-bottom:100px}.end-cta h2{font-size:38px;color:#173e36;letter-spacing:-.05em}.end-cta p{color:#6d7d71;margin-bottom:28px}@media(max-width:760px){.page-head{padding-top:62px;padding-bottom:54px}.content{display:block;padding-top:60px;padding-bottom:60px}.section-label{margin-bottom:25px}.experience,.education-item{grid-template-columns:1fr}.project-top{flex-direction:column;gap:8px}.end-cta{padding-top:65px;padding-bottom:75px}}
</style>
