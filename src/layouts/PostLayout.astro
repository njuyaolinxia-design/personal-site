---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} active="blog">
  <article class="article wrap"><a class="back" href="/blog/">← 返回文章列表</a><header><span class="eyebrow">{frontmatter.category} / {new Date(frontmatter.pubDate).toISOString().slice(0, 10)}</span><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p></header><div class="article-body"><slot /></div><footer><a class="btn btn-outline" href="/blog/">阅读其他文章 ↗</a></footer></article>
</BaseLayout>
<style is:global>
  .article{max-width:840px;padding-top:65px;padding-bottom:100px}.article .back{color:#5b8062;font-size:12px;font-weight:700}.article header{padding:70px 0 45px;border-bottom:1px solid #d5e3d4}.article h1{font-size:clamp(39px,6vw,64px);line-height:1.2;letter-spacing:-.06em;color:#173e36;margin:22px 0}.article header p{color:#667c70;line-height:1.8}.article-body{padding:25px 0 50px;font-size:16px;line-height:1.95;color:#334c3e}.article-body h2{font-size:28px;color:#173e36;letter-spacing:-.04em;margin-top:48px}.article-body h3{font-size:21px;color:#173e36}.article-body a{color:#2c7e55;text-decoration:underline}.article-body blockquote{margin:30px 0;padding:5px 22px;border-left:3px solid #91ba69;background:#eaf1e7;color:#47654d}.article-body code{font-family:Consolas,monospace;font-size:.9em;background:#e7eee4;padding:2px 5px;border-radius:4px}.article-body pre{overflow:auto;padding:20px;background:#183a33;color:#ebf5e8;border-radius:8px}.article-body pre code{background:transparent;padding:0}.article-body img{max-width:100%;height:auto}.article-body li{margin:7px 0}.article footer{border-top:1px solid #d5e3d4;padding-top:30px}@media(max-width:760px){.article{padding-top:40px;padding-bottom:70px}.article header{padding-top:50px}}
</style>
